{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "e2e/**/*.ts",
        "e2e/**/*.js",
        "tests/**/*.ts",
        "tests/**/*.js",
        "playwright.config.ts"
    ]
}