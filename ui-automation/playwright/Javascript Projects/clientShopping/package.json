{
  "name": "client-shopping-playwright-js",
  "version": "1.0.0",
  "description": "Playwright (JavaScript) UI + API tests for the Rahul Shetty Academy client shop",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:web": "playwright test --grep @Web",
    "test:api": "playwright test --grep @API",
    "test:azure": "playwright test --config=playwright.service.config.js",
    "report": "playwright show-report",
    "report:allure": "allure generate allure-results --clean -o allure-report && allure open allure-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@azure/identity": "^4.13.3",
    "@azure/playwright": "^1.1.6",
    "@playwright/test": "^1.63.0",
    "@types/node": "^25.9.9",
    "allure-playwright": "^3.13.0",
    "dotenv": "^18.0.3"
  },
  "private": true
}
