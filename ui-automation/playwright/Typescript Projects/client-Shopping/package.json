{
  "name": "client-shopping-playwright-ts",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright TypeScript UI and API tests for the client shop, Angular practice, SauceDemo, and EventHub",
  "type": "commonjs",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:web": "playwright test --grep @Web",
    "test:api": "playwright test --grep @API",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0"
  }
}
