<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- parallel="methods" + ThreadLocal driver = safe concurrent execution.
     Run a subset:  mvn test -Dgroups=smoke  -->
<suite name="Full Regression Suite" parallel="methods" thread-count="3" verbose="1">

    <listeners>
        <listener class-name="com.qa.framework.listeners.TestListener"/>
    </listeners>

    <parameter name="browser" value="chrome"/>

    <test name="UI Tests">
        <classes>
            <class name="com.qa.framework.tests.LoginTest"/>
            <class name="com.qa.framework.tests.EndToEndPurchaseTest"/>
        </classes>
    </test>

    <!-- API and DB tests need no browser, so they run single-threaded and fast -->
    <test name="API Tests" parallel="false">
        <classes>
            <class name="com.qa.framework.api.BookingApiTest"/>
        </classes>
    </test>

    <test name="DB Tests" parallel="false">
        <classes>
            <class name="com.qa.framework.db.DatabaseValidationTest"/>
        </classes>
    </test>

    <test name="BDD Scenarios" parallel="false">
        <classes>
            <class name="com.qa.framework.runner.CucumberRunner"/>
        </classes>
    </test>
</suite>
